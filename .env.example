# ===== Supabase (Project Settings → API) =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key หรือ secret key (sb_secret_...) — ห้ามใส่ NEXT_PUBLIC_ นำหน้า
SUPABASE_SERVICE_ROLE_KEY=

# ===== พร้อมเพย์ =====
# เบอร์มือถือ 10 หลัก (ไม่มีขีด) หรือเลขบัตรประชาชน 13 หลัก
PROMPTPAY_ID=0812345678

# ===== Google Sheet (Apps Script Web App URL ลงท้าย /exec) =====
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=

# ===== ตรวจสลิปอัตโนมัติ (ไม่บังคับ) =====
# สมัครที่ developer.easyslip.com → เอา API key มาใส่
# ไม่ใส่ = ลูกค้าแนบสลิปได้ปกติ แต่ร้านต้องเปิดดูสลิปในชีตแล้วเปลี่ยนสถานะเอง
EASYSLIP_API_KEY=
# เลขบัญชีธนาคารร้าน (ไม่บังคับ) ใช้เช็กว่าโอนเข้าบัญชีร้านจริง ถ้ารับโอนเข้าบัญชีด้วย ไม่ใช่แค่พร้อมเพย์
SHOP_BANK_ACCOUNT=

# ===== ลิงก์ติดต่อร้าน (LINE OA / Messenger / IG) — ไม่บังคับ =====
NEXT_PUBLIC_CONTACT_URL=https://line.me/R/ti/p/@yourshop
